# Скопировать в terraform.tfvars и заполнить своими значениями.
# terraform.tfvars в .gitignore — секреты в репозиторий не попадут.

pve_endpoint = "https://192.168.10.230:8006/"

# Получен командой: pveum user token add terraform@pve provider --privsep=0
# Формат: <user>@<realm>!<token-id>=<secret>
pve_api_token = "terraform@pve!provider=00000000-0000-0000-0000-000000000000"

pve_node = "pve"

# Посмотреть доступные:  pvesm status
system_datastore = "local-lvm"                    # SSD1, создаётся инсталлятором
data_datastores  = ["ssd-data-1", "ssd-data-2"]   # SSD2 и SSD3, создаются на этапе 1.1.1
image_datastore  = "local"

network_bridge = "vmbr0"
gateway        = "192.168.10.1"
dns_servers    = ["192.168.10.1", "1.1.1.1"]

ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# 3 × 40 ГБ = 120 ГБ на local-lvm (thin-пул 137 ГБ на Samsung)
system_disk_size = 40

# 3 × 35 ГБ = 105 ГБ на каждом ssd-data-* (DEXP по 118 ГБ)
data_disk_size = 35

# Топология под i3-8100 (4 потока) и 32 ГБ RAM.
# 3 vCPU × 3 ноды = 9 vCPU при 4 потоках — переподписка 2.25:1, для стенда нормально.
# 8 ГБ × 3 = 24 ГБ, хосту остаётся 8 ГБ.
# IP в статическом диапазоне .230-.254 (вне суженного DHCP-пула .10-.229).
nodes = {
  "k3s-1" = { vmid = 201, ip = "192.168.10.231", cores = 3, memory = 8192, role = "server" }
  "k3s-2" = { vmid = 202, ip = "192.168.10.232", cores = 3, memory = 8192, role = "server" }
  "k3s-3" = { vmid = 203, ip = "192.168.10.233", cores = 3, memory = 8192, role = "server" }
}
